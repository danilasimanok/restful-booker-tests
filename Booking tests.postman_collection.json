							"function deleteById(bookingId) {",
							"    const deleteRequest = {",
							"        url: baseUrl + \"/booking/\" + bookingId,",
							"        method: 'DELETE',",
							"        header: { 'Authorization': 'Basic YWRtaW46cGFzc3dvcmQxMjM=' }",
							"    };",
							"    pm.sendRequest(deleteRequest, (error, response) => {});",
							"}",
							"const getRequestString = baseUrl + \"/booking?firstname=John&lastname=Doe\";",
							"pm.sendRequest(getRequestString, (err, response) => {",
							"    response.json().forEach((bookingJson) => {",
							"        deleteById(bookingJson.bookingid);",
							"    })",
							"});"
