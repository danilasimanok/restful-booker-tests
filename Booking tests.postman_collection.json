											"const john = translation[\"John\"];",
											"const responseJson = pm.response.json();",
											"",
											"async function getBookingJson (bookingId) {",
											"    const getRequestString = baseUrl + \"/booking/\" + bookingId;",
											"    pm.sendRequest(getRequestString, (error, response) => {",
											"        return response.json();",
											"    });",
											"}",
											"",
											"pm.test(\"Every booking name is John\", function () {",
											"    responseJson.forEach((booking) => {",
											"        getBookingJson(booking.bookingid).then((bookingJson) => {",
											"            pm.expect(bookingJson.firstname).to.eql(john);",
											"        });",
											"        console.log(booking.bookingid);",
											"    });",
											"});",
											"",
											"const ids = pm.variables.get(\"ids\");",
											"function deleteById(bookingId) {",
											"    const deleteRequest = {",
											"        url: baseUrl + \"/booking/\" + bookingId,",
